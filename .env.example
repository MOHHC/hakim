# LLM APIs
GEMINI_API_KEY=your_gemini_api_key_here
# One key, or several comma-separated: quota is per key, so listing spares
# lets a batch run continue past an exhausted key.
GROQ_API_KEY=your_groq_api_key_here,optional_second_key

# Observability — Langfuse (LLM tracing)
# Option A: Cloud (free tier) → https://cloud.langfuse.com
# Option B: Self-hosted via docker-compose → set host to http://localhost:3001
#   1. Run: docker-compose up langfuse langfuse-db
#   2. Open http://localhost:3001, sign up, create a project
#   3. Copy the project keys below
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3001

# App settings
APP_NAME=Hakim
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:8000
